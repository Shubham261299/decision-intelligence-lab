# Set these in your shell; DecisionLab does not automatically load .env files.
OPENAI_API_KEY=replace-with-your-api-key
# Choose an available model supporting Responses API strict structured outputs.
OPENAI_MODEL=replace-with-your-model-id
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_OUTPUT_TOKENS=2000
OPENAI_MAX_RETRIES=0
# Optional: leave empty to omit (some models reject temperature).
OPENAI_TEMPERATURE=
# Provider selection; environment variables are read explicitly, not via dotenv.
DECISIONLAB_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_MAX_OUTPUT_TOKENS=2000
OLLAMA_TEMPERATURE=0
